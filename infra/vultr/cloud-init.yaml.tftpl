#cloud-config
# First-boot bootstrap only. It is deliberately small and fixed: everything that changes lives in
# the repo (docker/remote-deploy.sh, docker/compose.prod.yml) and ships via the deploy workflow.
package_update: true
packages: [git, curl, ca-certificates]
write_files:
  - path: /opt/dispel/.env
    permissions: "0600"
    content: |
      API_KEY=${api_key}
      MODEL_DIR=/models
      DEVICE=${device}
      DOMAIN=${domain}
  - path: /opt/dispel/deploy.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      # Fixed wrapper: update the repo, then hand over to the repo's own deploy script (stdin passes through).
      set -e
      cd /opt/dispel
      [ -d repo ] || git clone ${repo_url} repo
      git -C repo fetch -q origin "${git_ref}"
      git -C repo checkout -q --force FETCH_HEAD
      exec sh repo/docker/remote-deploy.sh
  - path: /opt/dispel/setup-storage.sh
    permissions: "0700"
    content: |
      #!/bin/sh
      # Mount the persistent models volume (Vultr block storage) at /opt/dispel/models.
      # Terraform attaches it after the server boots, so wait for it. A volume that already
      # has a filesystem (re-attached after a server replacement) is kept as is.
      dev=/dev/vdb
      i=0
      while [ ! -b "$dev" ] && [ "$i" -lt 60 ]; do sleep 5; i=$((i+1)); done
      if [ ! -b "$dev" ]; then echo "WARNING: models volume did not appear; weights would sit on the local disk"; exit 0; fi
      blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -q -L dispel-models "$dev"
      grep -q dispel-models /etc/fstab || echo 'LABEL=dispel-models /opt/dispel/models ext4 defaults,nofail 0 2' >> /etc/fstab
      mkdir -p /opt/dispel/models
      mount /opt/dispel/models
  - path: /opt/dispel/setup-deploy-user.sh
    permissions: "0700"
    content: |
      #!/bin/sh
      set -e
      # CI logs in as `deploy`; its key may only run deploy.sh (no shell, no forwarding).
      id deploy >/dev/null 2>&1 || useradd -m -s /bin/bash -G docker deploy
      install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
      printf 'restrict,command="/opt/dispel/deploy.sh" %s\n' '${deploy_public_key}' > /home/deploy/.ssh/authorized_keys
      chown deploy:deploy /home/deploy/.ssh/authorized_keys
      chmod 600 /home/deploy/.ssh/authorized_keys
      chown -R deploy:deploy /opt/dispel
runcmd:
  - mkdir -p /opt/dispel/models
  - /opt/dispel/setup-storage.sh
  - curl -fsSL https://get.docker.com | sh
  - /opt/dispel/deploy.sh < /dev/null
  - /opt/dispel/setup-deploy-user.sh
